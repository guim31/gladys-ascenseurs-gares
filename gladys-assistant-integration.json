  "name": "Ascenseurs gares SNCF et Paris",
  "description": {
    "en": "Lifts and escalators of SNCF stations and Paris streets: in service or out of order (open data).",
    "fr": "Ascenseurs et escalators des gares SNCF et des rues de Paris : en service ou en panne (open data).",
    "de": "Aufzüge und Rolltreppen der SNCF-Bahnhöfe und Pariser Straßen: in Betrieb oder gestört.",
    "es": "Ascensores y escaleras mecánicas de estaciones SNCF y calles de París: en servicio o averiados."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-ascenseurs-gares:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-ascenseurs-gares/main/cover.png",
  "categories": ["services"],
  "transports": ["cloud"],
  "countries": ["FR"],
  "keywords": [
    "SNCF",
    "gare",
    "ascenseur",
    "escalator",
    "accessibilité",
    "PMR",
    "Paris",
    "voirie",
    "lift",
    "elevator"
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Fonctionnement",
        "de": "So funktioniert es",
        "es": "Funcionamiento"
      },
      "description": {
        "en": "Type your stations and/or tick districts of Paris, then save: they appear in the Discover tab with their lifts and escalators. Add the ones you want to Gladys. No account, no key.",
        "fr": "Tapez vos gares et/ou cochez des arrondissements de Paris, puis enregistrez : ils apparaissent dans l'onglet Découverte avec leurs ascenseurs et escalators. Ajoutez ceux qui vous intéressent à Gladys. Sans compte ni clé.",
        "de": "Gib deine Bahnhöfe ein und/oder wähle Pariser Arrondissements und speichere: sie erscheinen im Tab „Entdecken“ mit ihren Aufzügen und Rolltreppen. Füge die gewünschten zu Gladys hinzu. Kein Konto, kein Schlüssel.",
        "es": "Escriba sus estaciones y/o marque distritos de París y guarde: aparecen en la pestaña Descubrir con sus ascensores y escaleras mecánicas. Añada a Gladys los que le interesen. Sin cuenta ni clave."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-ascenseurs-gares/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide de configuration",
            "de": "Einrichtungsanleitung",
            "es": "Guía de configuración"
          }
        }
      ]
    },
