{
  "manifest_version": 1,
  "type": "device",
  "name": "Ascenseurs en gare SNCF",
  "description": {
    "en": "Lifts and escalators of SNCF stations: in service or out of order, from SNCF open data.",
    "fr": "Ascenseurs et escalators des gares SNCF : en service ou en panne, d'après l'open data SNCF.",
    "de": "Aufzüge und Rolltreppen der SNCF-Bahnhöfe: in Betrieb oder gestört (SNCF Open Data).",
    "es": "Ascensores y escaleras mecánicas de estaciones SNCF: en servicio o averiados (datos abiertos)."
  },
  "version": "1.0.0",
  "docker_image": "ghcr.io/guim31/gladys-ascenseurs-gares:1.0.0",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-ascenseurs-gares/main/cover.png",
  "categories": ["services"],
  "transports": ["cloud"],
  "countries": ["FR"],
  "keywords": [
    "SNCF",
    "gare",
    "ascenseur",
    "escalator",
    "accessibilité",
    "PMR",
    "Gares & Connexions",
    "lift",
    "elevator",
    "accessibility"
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "How it works",
        "fr": "Fonctionnement",
        "de": "So funktioniert es",
        "es": "Funcionamiento"
      },
      "description": {
        "en": "Type your stations and save: they appear in the Discover tab with their lifts and escalators. Add the ones you want to Gladys. No account, no key.",
        "fr": "Tapez vos gares et enregistrez : elles apparaissent dans l'onglet Découverte avec leurs ascenseurs et escalators. Ajoutez celles qui vous intéressent à Gladys. Sans compte ni clé.",
        "de": "Gib deine Bahnhöfe ein und speichere: sie erscheinen im Tab „Entdecken“ mit ihren Aufzügen und Rolltreppen. Füge die gewünschten zu Gladys hinzu. Kein Konto, kein Schlüssel.",
        "es": "Escriba sus estaciones y guarde: aparecen en la pestaña Descubrir con sus ascensores y escaleras mecánicas. Añada a Gladys las que le interesen. Sin cuenta ni clave."
      },
      "links": [
        {
          "url": "https://github.com/guim31/gladys-ascenseurs-gares/blob/main/docs/en.md",
          "label": {
            "en": "Setup guide",
            "fr": "Guide de configuration",
            "de": "Einrichtungsanleitung",
            "es": "Guía de configuración"
          }
        }
      ]
    },
    {
      "key": "stations",
      "type": "string",
      "required": false,
      "default": "",
      "label": {
        "en": "Stations",
        "fr": "Gares",
        "de": "Bahnhöfe",
        "es": "Estaciones"
      },
      "description": {
        "en": "Names separated by \";\", 10 at most. A partial name (a city) lists its stations with equipment.",
        "fr": "Noms séparés par « ; », 10 au plus. Un nom partiel (une ville) liste ses gares équipées.",
        "de": "Namen durch „;“ getrennt, höchstens 10. Ein Teilname (eine Stadt) listet ihre Bahnhöfe mit Anlagen.",
        "es": "Nombres separados por «;», 10 como máximo. Un nombre parcial (una ciudad) lista sus estaciones equipadas."
      },
      "placeholder": {
        "en": "Toulouse Matabiau; Paris Saint-Lazare",
        "fr": "Toulouse Matabiau; Paris Saint-Lazare",
        "de": "Toulouse Matabiau; Paris Saint-Lazare",
        "es": "Toulouse Matabiau; Paris Saint-Lazare"
      }
    },
    {
      "key": "refresh_interval",
      "type": "select",
      "default": "900",
      "label": {
        "en": "Refresh",
        "fr": "Rafraîchissement",
        "de": "Aktualisierung",
        "es": "Actualización"
      },
      "description": {
        "en": "SNCF updates the states every hour.",
        "fr": "SNCF met les états à jour toutes les heures.",
        "de": "SNCF aktualisiert die Zustände stündlich.",
        "es": "SNCF actualiza los estados cada hora."
      },
      "options": [
        {
          "value": "600",
          "label": {
            "en": "Every 10 minutes",
            "fr": "Toutes les 10 minutes",
            "de": "Alle 10 Minuten",
            "es": "Cada 10 minutos"
          }
        },
        {
          "value": "900",
          "label": {
            "en": "Every 15 minutes",
            "fr": "Toutes les 15 minutes",
            "de": "Alle 15 Minuten",
            "es": "Cada 15 minutos"
          }
        },
        {
          "value": "1800",
          "label": {
            "en": "Every 30 minutes",
            "fr": "Toutes les 30 minutes",
            "de": "Alle 30 Minuten",
            "es": "Cada 30 minutos"
          }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "default": "fr",
      "label": {
        "en": "Language of names and messages",
        "fr": "Langue des noms et messages",
        "de": "Sprache der Namen und Nachrichten",
        "es": "Idioma de nombres y mensajes"
      },
      "description": {
        "en": "Feature names are fixed when a device is added.",
        "fr": "Les noms des fonctionnalités sont figés à l'ajout de l'appareil.",
        "de": "Die Namen der Funktionen werden beim Hinzufügen festgelegt.",
        "es": "Los nombres de las funciones se fijan al añadir el dispositivo."
      },
      "options": [
        {
          "value": "en",
          "label": {
            "en": "English",
            "fr": "Anglais",
            "de": "Englisch",
            "es": "Inglés"
          }
        },
        {
          "value": "fr",
          "label": {
            "en": "French",
            "fr": "Français",
            "de": "Französisch",
            "es": "Francés"
          }
        },
        {
          "value": "de",
          "label": {
            "en": "German",
            "fr": "Allemand",
            "de": "Deutsch",
            "es": "Alemán"
          }
        },
        {
          "value": "es",
          "label": {
            "en": "Spanish",
            "fr": "Espagnol",
            "de": "Spanisch",
            "es": "Español"
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "key": "status",
      "label": {
        "en": "Status",
        "fr": "État",
        "de": "Status",
        "es": "Estado"
      },
      "description": {
        "en": "Stations found for the names typed, last reading and errors.",
        "fr": "Gares trouvées pour les noms saisis, dernière lecture et erreurs.",
        "de": "Gefundene Bahnhöfe für die eingegebenen Namen, letzte Abfrage und Fehler.",
        "es": "Estaciones encontradas para los nombres introducidos, última lectura y errores."
      },
      "timeout_seconds": 30,
      "fields": []
    }
  ],
  "scene_triggers": [
    {
      "key": "equipment_down",
      "label": {
        "en": "Lift or escalator out of order",
        "fr": "Ascenseur ou escalator en panne",
        "de": "Aufzug oder Rolltreppe gestört",
        "es": "Ascensor o escalera mecánica averiados"
      },
      "description": {
        "en": "A lift, escalator or moving walkway of a followed station goes out of order.",
        "fr": "Un ascenseur, escalator ou trottoir roulant d'une gare suivie tombe en panne.",
        "de": "Ein Aufzug, eine Rolltreppe oder ein Fahrsteig eines verfolgten Bahnhofs fällt aus.",
        "es": "Un ascensor, escalera mecánica o pasillo rodante de una estación seguida se avería."
      },
      "fields": [
        {
          "key": "station",
          "type": "multi_select",
          "source": "devices",
          "required": false,
          "label": {
            "en": "Stations",
            "fr": "Gares",
            "de": "Bahnhöfe",
            "es": "Estaciones"
          },
          "description": {
            "en": "Empty: any followed station.",
            "fr": "Vide : n'importe quelle gare suivie.",
            "de": "Leer: jeder verfolgte Bahnhof.",
            "es": "Vacío: cualquier estación seguida."
          }
        },
        {
          "key": "kind",
          "type": "select",
          "required": false,
          "label": {
            "en": "Equipment",
            "fr": "Équipement",
            "de": "Anlage",
            "es": "Equipo"
          },
          "description": {
            "en": "Empty: any kind. One equipment in particular: use its feature in a device state trigger.",
            "fr": "Vide : tous types. Pour un équipement précis : son état, dans un déclencheur d'appareil.",
            "de": "Leer: jede Art. Für eine bestimmte Anlage: ihr Zustand in einem Geräte-Auslöser.",
            "es": "Vacío: cualquier tipo. Para un equipo concreto: su estado en un disparador de dispositivo."
          },
          "options": [
            {
              "value": "elevator",
              "label": {
                "en": "Lift",
                "fr": "Ascenseur",
                "de": "Aufzug",
                "es": "Ascensor"
              }
            },
            {
              "value": "escalator",
              "label": {
                "en": "Escalator",
                "fr": "Escalator",
                "de": "Rolltreppe",
                "es": "Escalera mecánica"
              }
            },
            {
              "value": "walkway",
              "label": {
                "en": "Moving walkway",
                "fr": "Trottoir roulant",
                "de": "Fahrsteig",
                "es": "Pasillo rodante"
              }
            }
          ]
        }
      ],
      "variables": [
        {
          "key": "station_name",
          "type": "string",
          "label": {
            "en": "Station",
            "fr": "Gare",
            "de": "Bahnhof",
            "es": "Estación"
          }
        },
        {
          "key": "equipment_name",
          "type": "string",
          "label": {
            "en": "Equipment",
            "fr": "Équipement",
            "de": "Anlage",
            "es": "Equipo"
          }
        },
        {
          "key": "location",
          "type": "string",
          "label": {
            "en": "Location",
            "fr": "Emplacement",
            "de": "Standort",
            "es": "Ubicación"
          }
        },
        {
          "key": "out_of_order",
          "type": "number",
          "label": {
            "en": "Out of order in the station",
            "fr": "En panne dans la gare",
            "de": "Außer Betrieb im Bahnhof",
            "es": "Fuera de servicio en la estación"
          }
        },
        {
          "key": "total",
          "type": "number",
          "label": {
            "en": "Equipment in the station",
            "fr": "Équipements de la gare",
            "de": "Anlagen im Bahnhof",
            "es": "Equipos de la estación"
          }
        }
      ]
    },
