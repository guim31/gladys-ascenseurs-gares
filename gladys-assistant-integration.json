  "scene_actions": [
    {
      "key": "summary",
      "label": {
        "en": "Summarize lifts and escalators",
        "fr": "Résumer l'état des ascenseurs",
        "de": "Aufzüge und Rolltreppen zusammenfassen",
        "es": "Resumir ascensores y escaleras mecánicas"
      },
      "description": {
        "en": "State of the equipment of your followed stations, with a sentence ready to send.",
        "fr": "État des équipements de vos gares suivies, avec une phrase prête à envoyer.",
        "de": "Zustand der Anlagen deiner verfolgten Bahnhöfe, mit einem fertigen Satz.",
        "es": "Estado de los equipos de sus estaciones seguidas, con una frase lista para enviar."
      },
      "timeout_seconds": 15,
      "fields": [
