  "widgets": [
    {
      "key": "station",
      "label": {
        "en": "Station lifts and escalators",
        "fr": "Ascenseurs de la gare",
        "de": "Aufzüge im Bahnhof",
        "es": "Ascensores de la estación"
      },
      "description": {
        "en": "The lifts and escalators of a station, out of order first.",
        "fr": "Les ascenseurs et escalators d'une gare, en panne d'abord.",
        "de": "Die Aufzüge und Rolltreppen eines Bahnhofs, gestörte zuerst.",
